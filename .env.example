# Database Configuration
DB_HOST=127.0.0.1
DB_USER=luxtronic_user
DB_PASSWORD=luxtronic_password
DB_NAME=luxtronic_price_approval_db
DB_PORT=5437

PORT=8006

# Luxtronic Odoo API (reads products, writes approved prices) - defaults to
# localhost:4001, correct while both services run on the same server.
ODOO_API_URL=http://localhost:4001

# Bearer key the Claude agent must send on /api/agent/* (the approval UI itself
# is LAN-only with no login, per the Luxtronic privacy guidelines).
# Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_API_KEY=change-me

# Top-level Odoo product categories treated as PC parts (the text before the
# first " / " in the category name). Matching products are auto-tracked on sync;
# you can switch individual products on/off on the Products page.
PC_CATEGORIES=CPU,GPU,DRAM,SSD,MB,PSU

# Sub-categories to leave out even though their top-level group is included above
# (full Odoo category names or prefixes, comma-separated). "PSU / Cable" holds cables and hubs.
EXCLUDE_CATEGORIES=PSU / Cable

# Allowed markups in AUD on top of the market price.
MARKUP_OPTIONS=0,5,10,15

# Daily automatic pricing run: hour of the day (0-23, Australia/Sydney time) from which one run starts.
# Leave blank to turn the schedule off (the Run pricing now button still works).
AUTO_RUN_HOUR=
